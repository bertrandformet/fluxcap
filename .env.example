# Backend
# Local : laisser vide (défauts SQLite local + localhost:5173 dans app/config.py)
# Render (prod) : géré par render.yaml, sauf CORS_ORIGINS à renseigner à la main
# une fois l'URL Vercel connue, ex. CORS_ORIGINS=https://taches-notes-veille.vercel.app
DATABASE_URL=
CORS_ORIGINS=
UPLOAD_DIR=

# Frontend
# Local : laisser vide (défaut http://localhost:8000 dans src/api/client.js)
# Vercel (prod) : URL du service Render, ex. https://taches-notes-veille-api.onrender.com
VITE_API_BASE_URL=
