# Backend
# Local : laisser vide (défauts SQLite local + localhost:5173 dans app/config.py)
# Render (prod, plan gratuit) : DATABASE_URL = connection string Postgres Supabase,
# CORS_ORIGINS = URL Vercel une fois connue, SUPABASE_* = pièces jointes (le disque
# du service Render gratuit n'est pas persistant). UPLOAD_DIR reste utile seulement
# si tu repasses un jour sur un disque local persistant.
DATABASE_URL=
CORS_ORIGINS=
UPLOAD_DIR=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
# Signature des sessions JWT. Local : laisser vide (défaut dev non sécurisé dans
# app/config.py). Render : générée automatiquement via render.yaml, ne rien saisir.
SECRET_KEY=
# WebAuthn (Face ID/Touch ID). Local : laisser vide (défaut localhost). Render :
# valeurs déjà renseignées dans render.yaml (domaine Vercel).
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_ORIGIN=

# Frontend
# Local : laisser vide (défaut http://localhost:8000 dans src/api/client.js)
# Vercel (prod) : URL du service Render, ex. https://taches-notes-veille-api.onrender.com
VITE_API_BASE_URL=
